{
  "name": "app",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && pnpm run build:sw",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/sw",
    "prepare": "cd .. && husky app/.husky",
    "version:check": "node scripts/bump-version.mjs --check --fetch",
    "version:next": "node scripts/bump-version.mjs --next",
    "version:bump": "node scripts/bump-version.mjs --bump",
    "build:sw": "vite build -c vite.sw.config.ts && node scripts/inject-sw-manifest.mjs",
    "lint:canary": "node scripts/lint-canary.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "stack:up": "docker compose -f dev-stack/docker-compose.yml up -d",
    "stack:down": "docker compose -f dev-stack/docker-compose.yml down",
    "mock:api": "node dev-stack/mock-api/serve.mjs",
    "mock:reset": "node -e \"require('node:fs').rmSync('dev-stack/mock-api/.state.json',{force:true});console.log('[mock-api] state cleared')\"",
    "test:nginx": "sh scripts/nginx-smoke.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "~0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "~1.170.40",
    "@tanstack/react-router-devtools": "~1.167.2",
    "@tanstack/react-start": "~1.168.59",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dexie": "^4.4.6",
    "dexie-export-import": "^4.4.1",
    "dexie-react-hooks": "^4.4.0",
    "fractional-indexing": "^4.0.0",
    "konsta": "5.5.0",
    "lucide-react": "^1.49.0",
    "markdown-to-jsx": "^9.10.3",
    "motion": "^13.4.6",
    "mqtt": "~5.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "~0.8.5",
    "@tanstack/eslint-config": "~0.4.0",
    "@tanstack/router-cli": "^1.167.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
